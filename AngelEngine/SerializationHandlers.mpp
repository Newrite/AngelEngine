module;

#include <EASTL/string.h>
#include <EASTL/vector.h>

#include <angelscript.h>
#include <scriptarray.h>
#include <scriptedictionary/scriptdictionary.h>

#include <cstring>

export module AngelEngine.SerializationHandlers;

import AngelEngine.Interfaces;
import AngelEngine.Logger;
import AngelEngine.SaveLoadManager;

namespace AngelEngine
{
    // Helper to determine if a type is stored in-place in global storage.
    // In AngelScript, reference types (asOBJ_REF) with non-zero size are allocated in-place 
    // within the module's global memory segment or as members of other objects.
    bool IsInPlace(asIScriptEngine* engine, int typeId)
    {
        if (typeId & asTYPEID_OBJHANDLE) return false;
        asITypeInfo* ti = engine->GetTypeInfoById(typeId);
        if (!ti) return false;
        
        if (ti->GetSize() > 0) return true;
        
        // Special case: "array" is a template type that may be registered with size 0 
        // but often behaves as an in-place object in this configuration.
        const char* name = ti->GetName();
        if (name)
        {
            if (strcmp(name, "array") == 0) return true;
            if (strcmp(name, "dictionary") == 0) return true;
        }
        
        return false;
    }

    // Helper to get the actual object pointer from a storage address.
    // Handles the distinction between in-place storage (ptr is the object) 
    // and pointer storage (ptr is address of the pointer).
    void* GetObjectPtr(asIScriptEngine* engine, void* ptr, int typeId)
    {
        if (IsInPlace(engine, typeId)) return ptr;
        return *static_cast<void**>(ptr);
    }

    // =======================================================================
    // ArraySerializationHandler
    // =======================================================================
    export class ArraySerializationHandler : public ISerializationHandler
    {
    public:
        ArraySerializationHandler() : engine_(nullptr), serializer_(nullptr) {}

        void SetSerializer(void* serializer) override
        {
            serializer_ = serializer;
        }

        void SetEngine(asIScriptEngine* engine) override
        {
            engine_ = engine;
        }

        bool CanHandle(int typeId) const override
        {
            if (!engine_)
                return false;

            asITypeInfo* type = engine_->GetTypeInfoById(typeId);
            if (!type)
                return false;

            const char* name = type->GetName();
            return (type->GetFlags() & asOBJ_TEMPLATE) &&
                   (type->GetFlags() & asOBJ_REF) &&
                   name != nullptr &&
                   eastl::string(name) == "array";
        }

        const char* GetTypeName() const override
        {
            return "array";
        }

        void Save(asIScriptEngine* engine, void* ptr, int typeId, asIBinaryStream* stream) override
        {
            CScriptArray* arr = static_cast<CScriptArray*>(GetObjectPtr(engine, ptr, typeId));
            if (!arr)
            {
                asUINT size = 0xFFFFFFFF;
                stream->Write(&size, sizeof(size));
                return;
            }

            asUINT size = arr->GetSize();
            stream->Write(&size, sizeof(size));

            if (size > 0)
            {
                int elemTypeId = arr->GetElementTypeId();
                for (asUINT i = 0; i < size; ++i)
                {
                    void* elemPtr = arr->At(i);
                    if (serializer_)
                    {
                        static_cast<ISerializationHandler*>(serializer_)->SerializeValue(elemPtr, elemTypeId, stream, true);
                    }
                }
            }
        }

        void Restore(asIScriptEngine* engine, void* ptr, int typeId, asIBinaryStream* stream) override
        {
            asUINT size = 0;
            if (stream->Read(&size, sizeof(size)) < 0)
                return;

            bool inPlace = IsInPlace(engine, typeId);
            CScriptArray* arr = nullptr;
            void** hptr = nullptr;

            if (inPlace)
            {
                arr = static_cast<CScriptArray*>(ptr);
            }
            else
            {
                hptr = static_cast<void**>(ptr);
                arr = static_cast<CScriptArray*>(*hptr);
            }

            if (size == 0xFFFFFFFF)
            {
                if (!inPlace && hptr && *hptr)
                {
                    static_cast<CScriptArray*>(*hptr)->Release();
                    *hptr = nullptr;
                }
                return;
            }

            if (!arr)
            {
                asITypeInfo* ti = engine->GetTypeInfoById(typeId);
                arr = CScriptArray::Create(ti);
                if (!inPlace && hptr) *hptr = arr;
            }

            arr->Resize(size);

            if (size > 0)
            {
                int elemTypeId = arr->GetElementTypeId();
                for (asUINT i = 0; i < size; ++i)
                {
                    void* elemPtr = arr->At(i);
                    if (serializer_)
                    {
                        static_cast<ISerializationHandler*>(serializer_)->SerializeValue(elemPtr, elemTypeId, stream, false);
                    }
                }
            }
        }

        bool SerializeValue(void* ptr, int typeId, asIBinaryStream* stream, bool isSave) override
        {
            return false;
        }

    private:
        asIScriptEngine* engine_;
        void* serializer_;
    };

    // =======================================================================
    // DictionarySerializationHandler
    // =======================================================================
    export class DictionarySerializationHandler : public ISerializationHandler
    {
    public:
        DictionarySerializationHandler() : engine_(nullptr), serializer_(nullptr) {}

        void SetSerializer(void* serializer) override
        {
            serializer_ = serializer;
        }

        void SetEngine(asIScriptEngine* engine) override
        {
            engine_ = engine;
        }

        bool CanHandle(int typeId) const override
        {
            if (!engine_)
                return false;

            asITypeInfo* type = engine_->GetTypeInfoById(typeId);
            if (!type)
                return false;

            const char* name = type->GetName();
            return (type->GetFlags() & asOBJ_REF) &&
                   name != nullptr &&
                   eastl::string(name) == "dictionary";
        }

        const char* GetTypeName() const override
        {
            return "dictionary";
        }

        void Save(asIScriptEngine* engine, void* ptr, int typeId, asIBinaryStream* stream) override
        {
            CScriptDictionary* dict = static_cast<CScriptDictionary*>(GetObjectPtr(engine, ptr, typeId));
            if (!dict)
            {
                asUINT keyCount = 0xFFFFFFFF;
                stream->Write(&keyCount, sizeof(keyCount));
                return;
            }

            CScriptArray* keysArray = dict->GetKeys();
            if (!keysArray)
            {
                asUINT keyCount = 0;
                stream->Write(&keyCount, sizeof(keyCount));
                return;
            }

            asUINT keyCount = keysArray->GetSize();
            stream->Write(&keyCount, sizeof(keyCount));

            for (asUINT i = 0; i < keyCount; ++i)
            {
                const dictKey_t* keyPtr = static_cast<const dictKey_t*>(keysArray->At(i));
                const dictKey_t& key = *keyPtr;

                uint32_t keyLen = static_cast<uint32_t>(key.length());
                stream->Write(&keyLen, sizeof(keyLen));
                if (keyLen > 0)
                    stream->Write(key.c_str(), keyLen);

                int valueTypeId = dict->GetTypeId(key.c_str());
                if (serializer_)
                {
                    auto* s = static_cast<BinarySerializer*>(serializer_);
                    if (!s->WriteStableType(valueTypeId))
                        continue;

                    const CScriptDictValue* dictValue = (*dict)[key.c_str()];
                    void* valPtr = const_cast<void*>(dictValue->GetAddressOfValue());
                    
                    s->SerializeValue(valPtr, valueTypeId, stream, true);
                }
            }
            keysArray->Release();
        }

        void Restore(asIScriptEngine* engine, void* ptr, int typeId, asIBinaryStream* stream) override
        {
            asUINT keyCount = 0;
            if (stream->Read(&keyCount, sizeof(keyCount)) < 0)
                return;

            bool inPlace = IsInPlace(engine, typeId);
            CScriptDictionary* dict = nullptr;
            void** hptr = nullptr;

            if (inPlace)
            {
                dict = static_cast<CScriptDictionary*>(ptr);
            }
            else
            {
                hptr = static_cast<void**>(ptr);
                dict = static_cast<CScriptDictionary*>(*hptr);
            }

            if (keyCount == 0xFFFFFFFF)
            {
                if (!inPlace && hptr && *hptr)
                {
                    static_cast<CScriptDictionary*>(*hptr)->Release();
                    *hptr = nullptr;
                }
                return;
            }

            if (!dict)
            {
                dict = CScriptDictionary::Create(engine);
                if (!inPlace && hptr) *hptr = dict;
            }

            dict->DeleteAll();

            int stringTypeId = engine->GetTypeIdByDecl("string");

            for (asUINT i = 0; i < keyCount; ++i)
            {
                uint32_t keyLen = 0;
                if (stream->Read(&keyLen, sizeof(keyLen)) < 0)
                    return;

                dictKey_t key;
                key.resize(keyLen);
                if (keyLen > 0)
                    stream->Read(key.data(), keyLen);

                if (serializer_)
                {
                    auto* s = static_cast<BinarySerializer*>(serializer_);
                    auto typeRes = s->ReadStableType();
                    if (!typeRes)
                        return;
                    int valueTypeId = typeRes.value();

                    if (valueTypeId == stringTypeId)
                    {
                        eastl::string str;
                        s->SerializeValue(&str, valueTypeId, stream, false);
                        dict->Set(key.c_str(), &str, valueTypeId);
                    }
                    else if (engine->GetSizeOfPrimitiveType(valueTypeId) > 0)
                    {
                        asINT64 dummy = 0;
                        s->SerializeValue(&dummy, valueTypeId, stream, false);
                        dict->Set(key.c_str(), &dummy, valueTypeId);
                    }
                    else
                    {
                        void* dummy = nullptr;
                        s->SerializeValue(&dummy, valueTypeId, stream, false);
                        dict->Set(key.c_str(), &dummy, valueTypeId);
                        if (dummy)
                        {
                            engine->ReleaseScriptObject(dummy, engine->GetTypeInfoById(valueTypeId));
                        }
                    }
                }
            }
        }

        bool SerializeValue(void* ptr, int typeId, asIBinaryStream* stream, bool isSave) override
        {
            return false;
        }

    private:
        asIScriptEngine* engine_;
        void* serializer_;
    };
} // namespace AngelEngine
