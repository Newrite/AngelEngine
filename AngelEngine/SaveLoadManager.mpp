module;

#include <EABase/eabase.h>
#include <EASTL/expected.h>
#include <EASTL/string.h>
#include <EASTL/vector.h>
#include <EASTL/vector_map.h>

#include <angelscript.h>

#include <cstring>

export module AngelEngine.SaveLoadManager;

import AngelEngine.Interfaces;
import AngelEngine.Logger;
import AngelEngine.Errors;
import AngelEngine.Types;

namespace AngelEngine
{
    // --- Format Constants ---
    constexpr uint32_t SAVE_MAGIC = 0x414E4745; // "ANGE"
    constexpr uint32_t SAVE_VERSION = 3; // V3: Universal length prefixing for all variables

    // Safety Limits
    constexpr uint32_t MAX_SAFE_STRING_LEN = 1024 * 1024; // 1 MB limit for actual string values
    constexpr int MAX_RECURSION_DEPTH = 64;

    export class ByteStreamWriter : public asIBinaryStream
    {
    public:
        ByteStreamWriter(eastl::vector<uint8_t>& buffer) : buffer_(buffer) {}

        int Write(const void* ptr, asUINT size) override
        {
            if (size == 0)
                return 0;
            const size_t currentSize = buffer_.size();
            const size_t newSize = currentSize + size;
            if (newSize > buffer_.capacity())
            {
                const size_t doubled = buffer_.capacity() * 2;
                buffer_.reserve(newSize > doubled ? newSize : (doubled > 1024 ? doubled : static_cast<size_t>(1024)));
            }
            buffer_.resize(newSize);
            std::memcpy(buffer_.data() + currentSize, ptr, size);
            return 0;
        }

        int Read(void* ptr, asUINT size) override { return -1; }

    private:
        eastl::vector<uint8_t>& buffer_;
    };

    export class ByteStreamReader : public asIBinaryStream
    {
    public:
        ByteStreamReader(const eastl::vector<uint8_t>& buffer) : buffer_(buffer), readPos_(0) {}

        int Write(const void* ptr, asUINT size) override { return -1; }

        int Read(void* ptr, asUINT size) override
        {
            if (size == 0)
                return 0;
            if (readPos_ + size > buffer_.size())
            {
                std::memset(ptr, 0, size);
                return -1;
            }
            std::memcpy(ptr, buffer_.data() + readPos_, size);
            readPos_ += size;
            return 0;
        }

    private:
        const eastl::vector<uint8_t>& buffer_;
        size_t readPos_;
    };

    // --- Helpers for Type Name Serialization ---
    export const char* GetPrimitiveTypeName(int typeId)
    {
        switch (typeId)
        {
        case asTYPEID_VOID:
            return "void";
        case asTYPEID_BOOL:
            return "bool";
        case asTYPEID_INT8:
            return "int8";
        case asTYPEID_INT16:
            return "int16";
        case asTYPEID_INT32:
            return "int";
        case asTYPEID_INT64:
            return "int64";
        case asTYPEID_UINT8:
            return "uint8";
        case asTYPEID_UINT16:
            return "uint16";
        case asTYPEID_UINT32:
            return "uint";
        case asTYPEID_UINT64:
            return "uint64";
        case asTYPEID_FLOAT:
            return "float";
        case asTYPEID_DOUBLE:
            return "double";
        default:
            return nullptr;
        }
    }

    export eastl::string GetFullTypeName(asIScriptEngine* engine, int typeId)
    {
        asITypeInfo* type = engine->GetTypeInfoById(typeId);
        if (!type)
        {
            const char* prim = GetPrimitiveTypeName(typeId);
            return prim ? prim : "unknown";
        }

        eastl::string name;
        const char* ns = type->GetNamespace();
        if (ns && ns[0] != '\0')
            name = eastl::string(ns) + "::";
        
        name += type->GetName();

        if (type->GetFlags() & asOBJ_TEMPLATE)
        {
            name += "<";
            for (asUINT n = 0; n < type->GetSubTypeCount(); n++)
            {
                if (n > 0) name += ",";
                name += GetFullTypeName(engine, type->GetSubTypeId(n));
            }
            name += ">";
        }

        return name;
    }

    export class BinarySerializer : public ISerializationHandler
    {
    public:
        BinarySerializer(asIScriptEngine* engine, asIBinaryStream* stream,
                         const eastl::vector<ISerializationHandler*>& handlers) :
            engine_(engine), stream_(stream), handlers_(handlers), depth_(0)
        {
            stringTypeId_ = engine_->GetTypeIdByDecl("string");
        }

        bool CanHandle(int typeId) const override { return false; }
        const char* GetTypeName() const override { return "BinarySerializer"; }
        void SetSerializer(void* serializer) override {}
        void SetEngine(asIScriptEngine* engine) override {}
        void Save(asIScriptEngine* engine, void* ptr, int typeId, asIBinaryStream* stream) override {}
        void Restore(asIScriptEngine* engine, void* ptr, int typeId, asIBinaryStream* stream) override {}
        
        bool SerializeValue(void* ptr, int typeId, asIBinaryStream* stream, bool isSave) override
        {
            if (isSave)
                return SaveValueInternalRecursive(ptr, typeId, stream);
            else
                return LoadValueInternalRecursive(ptr, typeId, stream);
        }

        bool SaveValue(void* ptr, int typeId)
        {
            return SaveValueInternalRecursive(ptr, typeId, stream_);
        }

        bool LoadValue(void* ptr, int typeId)
        {
            return LoadValueInternalRecursive(ptr, typeId, stream_);
        }

        bool WriteStableType(int typeId)
        {
            bool isHandle = (typeId & asTYPEID_OBJHANDLE) != 0;
            stream_->Write(&isHandle, sizeof(isHandle));

            asITypeInfo* type = engine_->GetTypeInfoById(typeId);
            
            bool isTemplate = type && (type->GetFlags() & asOBJ_TEMPLATE);

            if (!isTemplate)
            {
                if (auto* handler = GetHandler(typeId))
                {
                    eastl::string typeName = eastl::string("@") + handler->GetTypeName();
                    uint32_t len = static_cast<uint32_t>(typeName.length());
                    stream_->Write(&len, sizeof(len));
                    if (len > 0)
                        stream_->Write(typeName.c_str(), len);
                    return true;
                }
            }

            if (type)
            {
                eastl::string fullName = GetFullTypeName(engine_, typeId & ~asTYPEID_OBJHANDLE);
                uint32_t len = static_cast<uint32_t>(fullName.length());
                stream_->Write(&len, sizeof(len));
                if (len > 0)
                    stream_->Write(fullName.c_str(), len);
                return true;
            }

            const char* primName = GetPrimitiveTypeName(typeId);
            if (primName)
            {
                uint32_t len = static_cast<uint32_t>(std::strlen(primName));
                stream_->Write(&len, sizeof(len));
                if (len > 0)
                    stream_->Write(primName, len);
                return true;
            }

            return false;
        }

        eastl::expected<int, SerializationError> ReadStableType()
        {
            bool isHandle = false;
            if (stream_->Read(&isHandle, sizeof(isHandle)) < 0)
                return eastl::unexpected(SerializationError::InvalidData);

            uint32_t len = 0;
            if (stream_->Read(&len, sizeof(len)) < 0)
                return eastl::unexpected(SerializationError::InvalidData);
            if (len > MAX_SAFE_STRING_LEN)
                return eastl::unexpected(SerializationError::CorruptData);

            eastl::string typeName;
            typeName.resize(len);
            if (len > 0)
            {
                if (stream_->Read(typeName.data(), len) < 0)
                    return eastl::unexpected(SerializationError::InvalidData);
            }

            auto ApplyFlags = [isHandle](int typeId) -> int
            { return isHandle ? (typeId | asTYPEID_OBJHANDLE) : typeId; };

            if (typeName.length() > 0 && typeName[0] == '@')
            {
                eastl::string hName = typeName.substr(1);
                int typeId = engine_->GetTypeIdByDecl(hName.c_str());
                
                if (typeId >= 0 && GetHandler(typeId) != nullptr)
                    return ApplyFlags(typeId);

                if (typeId < 0)
                {
                    asIScriptModule* mod = engine_->GetModule(MegaModuleName, asGM_ONLY_IF_EXISTS);
                    if (mod)
                        typeId = mod->GetTypeIdByDecl(hName.c_str());
                }

                if (typeId >= 0)
                    return ApplyFlags(typeId);

                return eastl::unexpected(SerializationError::TypeMismatch);
            }

            int typeId = engine_->GetTypeIdByDecl(typeName.c_str());
            if (typeId < 0)
            {
                asITypeInfo* ti = engine_->GetTypeInfoByDecl(typeName.c_str());
                if (ti) typeId = ti->GetTypeId();
            }

            if (typeId < 0)
            {
                asIScriptModule* mod = engine_->GetModule(MegaModuleName, asGM_ONLY_IF_EXISTS);
                if (mod)
                {
                    typeId = mod->GetTypeIdByDecl(typeName.c_str());
                    if (typeId < 0)
                    {
                        asITypeInfo* ti = mod->GetTypeInfoByDecl(typeName.c_str());
                        if (ti) typeId = ti->GetTypeId();
                    }
                }
            }

            if (typeId >= 0)
                return ApplyFlags(typeId);

            if (typeName == "void") return ApplyFlags(asTYPEID_VOID);
            if (typeName == "bool") return ApplyFlags(asTYPEID_BOOL);
            if (typeName == "int8") return ApplyFlags(asTYPEID_INT8);
            if (typeName == "int16") return ApplyFlags(asTYPEID_INT16);
            if (typeName == "int") return ApplyFlags(asTYPEID_INT32);
            if (typeName == "int64") return ApplyFlags(asTYPEID_INT64);
            if (typeName == "uint8") return ApplyFlags(asTYPEID_UINT8);
            if (typeName == "uint16") return ApplyFlags(asTYPEID_UINT16);
            if (typeName == "uint") return ApplyFlags(asTYPEID_UINT32);
            if (typeName == "uint64") return ApplyFlags(asTYPEID_UINT64);
            if (typeName == "float") return ApplyFlags(asTYPEID_FLOAT);
            if (typeName == "double") return ApplyFlags(asTYPEID_DOUBLE);

            return eastl::unexpected(SerializationError::TypeMismatch);
        }

    public:
        bool SaveValueInternal(void* ptr, int typeId, asIBinaryStream* targetStream)
        {
            return SaveValueInternalRecursive(ptr, typeId, targetStream);
        }

        bool LoadValueInternal(void* ptr, int typeId, asIBinaryStream* sourceStream)
        {
            return LoadValueInternalRecursive(ptr, typeId, sourceStream);
        }

    private:
        bool SaveValueInternalRecursive(void* ptr, int typeId, asIBinaryStream* targetStream)
        {
            if (depth_ >= MAX_RECURSION_DEPTH) return false;
            depth_++;

            // 1. Handles
            if (typeId & asTYPEID_OBJHANDLE)
            {
                void* obj = *static_cast<void**>(ptr);
                bool isNull = (obj == nullptr);
                targetStream->Write(&isNull, sizeof(bool));

                if (isNull)
                {
                    depth_--;
                    return true;
                }

                // Recursively save. We pass address of the handle (ptr) but without handle bit.
                bool res = SaveValueInternalRecursive(ptr, typeId & ~asTYPEID_OBJHANDLE, targetStream);
                depth_--;
                return res;
            }

            // 2. Handlers
            if (auto* handler = GetHandler(typeId))
            {
                handler->Save(engine_, ptr, typeId, targetStream);
                depth_--;
                return true;
            }

            // 3. Strings
            if (typeId == stringTypeId_ || stringTypeId_ == -1)
            {
                asITypeInfo* ti = engine_->GetTypeInfoById(typeId);
                if (typeId == stringTypeId_ || (ti && eastl::string(ti->GetName()) == "string"))
                {
                    eastl::string* s = static_cast<eastl::string*>(ptr);
                    uint32_t len = static_cast<uint32_t>(s ? s->length() : 0);
                    targetStream->Write(&len, sizeof(len));
                    if (len > 0) targetStream->Write(s->c_str(), len);
                    depth_--;
                    return true;
                }
            }

            // 4. Script Objects
            if (typeId & asTYPEID_SCRIPTOBJECT)
            {
                // ptr is address of storage (void**)
                void* objPtr = *static_cast<void**>(ptr);
                if (!objPtr) { depth_--; return false; }

                asIScriptObject* obj = static_cast<asIScriptObject*>(objPtr);
                asITypeInfo* objType = obj->GetObjectType();
                asUINT propCount = objType->GetPropertyCount();

                for (asUINT i = 0; i < propCount; ++i)
                {
                    int propTypeId;
                    objType->GetProperty(i, nullptr, &propTypeId);
                    void* propPtr = obj->GetAddressOfProperty(i);
                    if (!SaveValueInternalRecursive(propPtr, propTypeId, targetStream))
                    {
                        depth_--;
                        return false;
                    }
                }
                depth_--;
                return true;
            }

            // 5. Primitives
            int size = engine_->GetSizeOfPrimitiveType(typeId);
            asITypeInfo* ti = engine_->GetTypeInfoById(typeId);
            if (size == 0 && ti) size = ti->GetSize();

            if (size > 0)
            {
                targetStream->Write(ptr, size);
                depth_--;
                return true;
            }

            depth_--;
            return false;
        }

        bool LoadValueInternalRecursive(void* ptr, int typeId, asIBinaryStream* sourceStream)
        {
            if (depth_ >= MAX_RECURSION_DEPTH) return false;
            depth_++;

            // 1. Handles
            if (typeId & asTYPEID_OBJHANDLE)
            {
                bool isNull = true;
                if (sourceStream->Read(&isNull, sizeof(bool)) < 0) { depth_--; return false; }

                void** handlePtr = static_cast<void**>(ptr);

                if (isNull)
                {
                    if (*handlePtr)
                    {
                        engine_->ReleaseScriptObject(*handlePtr, engine_->GetTypeInfoById(typeId));
                        *handlePtr = nullptr;
                    }
                    depth_--;
                    return true;
                }
                else
                {
                    asITypeInfo* typeInfo = engine_->GetTypeInfoById(typeId);
                    if (!typeInfo) { depth_--; return false; }

                    if (*handlePtr == nullptr)
                        *handlePtr = engine_->CreateScriptObject(typeInfo);

                    bool res = LoadValueInternalRecursive(ptr, typeInfo->GetTypeId(), sourceStream);
                    depth_--;
                    return res;
                }
            }

            // 2. Handlers
            if (auto* handler = GetHandler(typeId))
            {
                handler->Restore(engine_, ptr, typeId, sourceStream);
                depth_--;
                return true;
            }

            // 3. Strings
            if (typeId == stringTypeId_ || stringTypeId_ == -1)
            {
                asITypeInfo* ti = engine_->GetTypeInfoById(typeId);
                if (typeId == stringTypeId_ || (ti && eastl::string(ti->GetName()) == "string"))
                {
                    uint32_t len = 0;
                    if (sourceStream->Read(&len, sizeof(len)) < 0) { depth_--; return false; }
                    if (len > MAX_SAFE_STRING_LEN) { depth_--; return false; }

                    eastl::string* s = static_cast<eastl::string*>(ptr);
                    if (s)
                    {
                        s->resize(len);
                        if (len > 0)
                            sourceStream->Read(s->data(), len);
                    }
                    depth_--;
                    return true;
                }
            }

            // 4. Script Objects
            if (typeId & asTYPEID_SCRIPTOBJECT)
            {
                void** handlePtr = static_cast<void**>(ptr);
                if (*handlePtr == nullptr)
                {
                    asITypeInfo* ti = engine_->GetTypeInfoById(typeId);
                    *handlePtr = engine_->CreateScriptObject(ti);
                }
                
                void* objPtr = *handlePtr;
                asIScriptObject* obj = static_cast<asIScriptObject*>(objPtr);
                asITypeInfo* objType = obj->GetObjectType();
                asUINT propCount = objType->GetPropertyCount();

                for (asUINT i = 0; i < propCount; ++i)
                {
                    int propTypeId;
                    objType->GetProperty(i, nullptr, &propTypeId);
                    void* propPtr = obj->GetAddressOfProperty(i);
                    if (!LoadValueInternalRecursive(propPtr, propTypeId, sourceStream))
                    {
                        depth_--;
                        return false;
                    }
                }
                depth_--;
                return true;
            }

            // 5. Primitives
            int size = engine_->GetSizeOfPrimitiveType(typeId);
            asITypeInfo* ti = engine_->GetTypeInfoById(typeId);
            if (size == 0 && ti) size = ti->GetSize();

            if (size > 0)
            {
                if (sourceStream->Read(ptr, size) < 0) { depth_--; return false; }
                depth_--;
                return true;
            }

            depth_--;
            return false;
        }

    private:
        ISerializationHandler* GetHandler(int typeId)
        {
            auto it = handlerCache_.find(typeId);
            if (it != handlerCache_.end()) return it->second;

            for (auto* handler : handlers_)
            {
                if (handler->CanHandle(typeId))
                {
                    handlerCache_[typeId] = handler;
                    return handler;
                }
            }
            handlerCache_[typeId] = nullptr;
            return nullptr;
        }

        asIScriptEngine* engine_;
        asIBinaryStream* stream_;
        const eastl::vector<ISerializationHandler*>& handlers_;
        int stringTypeId_;
        eastl::vector_map<int, ISerializationHandler*> handlerCache_;
        int depth_;
    };

    export class SaveLoadManager final : public ISaveLoadManager
    {
    public:
        void AddHandler(ISerializationHandler* handler) override { handlers_.push_back(handler); }

        eastl::expected<eastl::vector<uint8_t>, SerializationError> GetSaveData(asIScriptEngine* engine,
                                                                                IModuleLoader* loader) override
        {
            eastl::vector<uint8_t> outData;
            ByteStreamWriter stream(outData);
            BinarySerializer serializer(engine, &stream, handlers_);

            for (auto* handler : handlers_)
            {
                handler->SetEngine(engine);
                handler->SetSerializer(&serializer);
            }

            stream.Write(&SAVE_MAGIC, sizeof(SAVE_MAGIC));
            stream.Write(&SAVE_VERSION, sizeof(SAVE_VERSION));

            const auto& modules = loader->GetLoadedModules();
            uint32_t modCount = static_cast<uint32_t>(modules.size());
            stream.Write(&modCount, sizeof(modCount));

            for (const auto& modName : modules)
            {
                uint32_t nameLen = static_cast<uint32_t>(modName.length());
                stream.Write(&nameLen, sizeof(nameLen));
                if (nameLen > 0) stream.Write(modName.c_str(), nameLen);

                asIScriptModule* mod = engine->GetModule(MegaModuleName, asGM_ONLY_IF_EXISTS);
                const auto& saveableVars = loader->GetSaveableVars(modName);
                uint32_t varCount = static_cast<uint32_t>(saveableVars.size());
                stream.Write(&varCount, sizeof(varCount));

                for (const auto& varName : saveableVars)
                {
                    uint32_t varNameLen = static_cast<uint32_t>(varName.length());
                    stream.Write(&varNameLen, sizeof(varNameLen));
                    if (varNameLen > 0) stream.Write(varName.c_str(), varNameLen);

                    eastl::string namespacedVarName = modName + "::" + varName;
                    int varIdx = mod->GetGlobalVarIndexByName(namespacedVarName.c_str());
                    if (varIdx < 0) varIdx = mod->GetGlobalVarIndexByName(varName.c_str());

                    if (varIdx >= 0)
                    {
                        int typeId = 0;
                        mod->GetGlobalVar(varIdx, nullptr, nullptr, &typeId);
                        void* ref = mod->GetAddressOfGlobalVar(varIdx);

                        if (!serializer.WriteStableType(typeId)) return eastl::unexpected(SerializationError::SaveFailed);

                        eastl::vector<uint8_t> valBuffer;
                        ByteStreamWriter valStream(valBuffer);
                        if (!serializer.SaveValueInternal(ref, typeId, &valStream)) return eastl::unexpected(SerializationError::SaveFailed);

                        uint32_t valSize = static_cast<uint32_t>(valBuffer.size());
                        stream.Write(&valSize, sizeof(valSize));
                        if (valSize > 0) stream.Write(valBuffer.data(), valSize);
                    }
                    else
                    {
                        return eastl::unexpected(SerializationError::SaveFailed);
                    }
                }
            }
            return outData;
        }

        eastl::expected<void, SerializationError> LoadFromData(asIScriptEngine* engine,
                                                               const eastl::vector<uint8_t>& data) override
        {
            if (data.empty()) return eastl::unexpected(SerializationError::InvalidData);
            ByteStreamReader stream(data);
            BinarySerializer serializer(engine, &stream, handlers_);

            for (auto* handler : handlers_)
            {
                handler->SetEngine(engine);
                handler->SetSerializer(&serializer);
            }

            uint32_t magic = 0;
            if (stream.Read(&magic, sizeof(magic)) < 0) return eastl::unexpected(SerializationError::InvalidData);
            if (magic != SAVE_MAGIC) return eastl::unexpected(SerializationError::VersionMismatch);

            uint32_t version = 0;
            if (stream.Read(&version, sizeof(version)) < 0) return eastl::unexpected(SerializationError::InvalidData);
            if (version != SAVE_VERSION) return eastl::unexpected(SerializationError::VersionMismatch);

            uint32_t modCount = 0;
            if (stream.Read(&modCount, sizeof(modCount)) < 0) return eastl::unexpected(SerializationError::InvalidData);

            for (uint32_t i = 0; i < modCount; ++i)
            {
                uint32_t nameLen = 0;
                stream.Read(&nameLen, sizeof(nameLen));
                eastl::string modName; modName.resize(nameLen);
                if (nameLen > 0) stream.Read(modName.data(), nameLen);

                asIScriptModule* mod = engine->GetModule(MegaModuleName, asGM_ONLY_IF_EXISTS);
                uint32_t varCount = 0;
                stream.Read(&varCount, sizeof(varCount));

                for (uint32_t j = 0; j < varCount; ++j)
                {
                    uint32_t varNameLen = 0;
                    stream.Read(&varNameLen, sizeof(varNameLen));
                    eastl::string varName; varName.resize(varNameLen);
                    if (varNameLen > 0) stream.Read(varName.data(), varNameLen);

                    auto typeRes = serializer.ReadStableType();
                    if (!typeRes) return eastl::unexpected(typeRes.error());
                    int storedTypeId = typeRes.value();

                    eastl::string namespacedVarName = modName + "::" + varName;
                    int varIdx = mod->GetGlobalVarIndexByName(namespacedVarName.c_str());
                    if (varIdx < 0) varIdx = mod->GetGlobalVarIndexByName(varName.c_str());

                    uint32_t valSize = 0;
                    stream.Read(&valSize, sizeof(valSize));

                    if (varIdx < 0)
                    {
                        if (valSize > 0)
                        {
                            uint8_t dummy[1024]; uint32_t toSkip = valSize;
                            while (toSkip > 0) {
                                uint32_t chunk = toSkip > 1024 ? 1024 : toSkip;
                                stream.Read(dummy, chunk); toSkip -= chunk;
                            }
                        }
                        continue;
                    }

                    int currentTypeId = 0;
                    mod->GetGlobalVar(varIdx, nullptr, nullptr, &currentTypeId);

                    if (currentTypeId != storedTypeId) return eastl::unexpected(SerializationError::TypeMismatch);

                    void* ref = mod->GetAddressOfGlobalVar(varIdx);
                    if (!serializer.LoadValueInternal(ref, currentTypeId, &stream)) return eastl::unexpected(SerializationError::CorruptData);
                }
            }
            return {};
        }

    private:
        eastl::vector<ISerializationHandler*> handlers_;
    };
} // namespace AngelEngine
